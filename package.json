{
  "name": "ask-hermes-mcp",
  "version": "0.1.0",
  "description": "A small stdio MCP bridge to a local Hermes Agent Gateway",
  "type": "module",
  "files": [
    "dist/ask-hermes-mcp.cjs"
  ],
  "bin": {
    "ask-hermes-mcp": "dist/ask-hermes-mcp.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fingergohappy/ask-hermes-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fingergohappy/ask-hermes-mcp/issues"
  },
  "homepage": "https://github.com/fingergohappy/ask-hermes-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hermes-agent",
    "codex",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/build-bundle.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "tsx src/index.ts",
    "format": "biome format --write src tests package.json tsconfig.json tsconfig.build.json biome.json",
    "lint": "biome check src tests package.json tsconfig.json tsconfig.build.json biome.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@goreleaser/nfpm": "2.47.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
